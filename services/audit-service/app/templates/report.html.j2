<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    body { font-family: -apple-system, "Segoe UI", sans-serif; font-size: 14px; color: #1f2328; margin: 40px; }
    h1 { font-size: 22px; border-bottom: 2px solid #3b82d4; padding-bottom: 8px; }
    h2 { font-size: 16px; color: #3b82d4; margin-top: 28px; }
    .meta { background: #f7f8fa; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px 16px; margin-bottom: 24px; }
    .meta table { border-collapse: collapse; width: 100%; }
    .meta td { padding: 4px 8px; }
    .meta td:first-child { font-weight: 600; width: 180px; }
    pre { background: #f7f8fa; border: 1px solid #e5e7eb; padding: 12px; border-radius: 4px; white-space: pre-wrap; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #e5e7eb; padding: 8px 12px; text-align: left; }
    th { background: #f7f8fa; font-weight: 600; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .badge-critical { background: #fee2e2; color: #dc2626; }
    .badge-high { background: #fed7aa; color: #ea580c; }
    .badge-medium { background: #fef9c3; color: #ca8a04; }
    .badge-low { background: #dcfce7; color: #16a34a; }
    footer { margin-top: 48px; border-top: 1px solid #e5e7eb; padding-top: 12px; font-size: 12px; color: #57606a; }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>

  <div class="meta">
    <table>
      <tr><td>Incident ID</td><td>{{ incident_id or '—' }}</td></tr>
      <tr><td>Severity</td><td><span class="badge badge-{{ severity or 'medium' }}">{{ (severity or 'medium') | upper }}</span></td></tr>
      <tr><td>Status</td><td>{{ status }}</td></tr>
      <tr><td>Started at</td><td>{{ started_at or '—' }}</td></tr>
      <tr><td>Resolved at</td><td>{{ resolved_at or '—' }}</td></tr>
      <tr><td>Time to detect</td><td>{{ '%.0f s' % ttd_seconds if ttd_seconds else '—' }}</td></tr>
      <tr><td>Time to resolve</td><td>{{ '%.0f s' % ttr_seconds if ttr_seconds else '—' }}</td></tr>
      <tr><td>Affected services</td><td>{{ (affected_services or []) | join(', ') or '—' }}</td></tr>
      <tr><td>Author</td><td>{{ author_id or '—' }}</td></tr>
      <tr><td>Generated at</td><td>{{ created_at }}</td></tr>
    </table>
  </div>

  <h2>Summary</h2>
  <p>{{ summary or '—' }}</p>

  <h2>Timeline</h2>
  {{ timeline_html }}

  <h2>Impact Analysis</h2>
  <p>{{ impact_analysis or '—' }}</p>

  <h2>Root Cause</h2>
  <p>{{ root_cause or '—' }}</p>

  <h2>Resolution</h2>
  <p>{{ resolution or '—' }}</p>

  <h2>Preventive Actions</h2>
  {{ preventive_actions_html }}

  <footer>
    Generated by LogPilot &mdash; {{ created_at }}
    {% if generation_model %} &bull; Model: {{ generation_model }}{% endif %}
  </footer>
</body>
</html>
