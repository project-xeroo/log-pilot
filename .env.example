# LogPilot environment variables
# Copy to .env and fill in real values

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://logpilot:logpilot@postgres:5432/logpilot

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-char-random-string

# ── AI Service ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
=======
# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://logpilot:logpilot@localhost:5432/logpilot

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set to "openai" (or any openai-compatible provider) and fill in key + base URL
# Leave as "stub" to run fully without an API key (template-based responses)
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_REASONING=gpt-4o
AI_MODEL_EMBEDDING=text-embedding-3-small

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECASTING_LOOP_INTERVAL_SECONDS=60
FORECASTING_WARNING_THRESHOLD=60.0
FORECASTING_CRITICAL_THRESHOLD=80.0
WEIGHT_VELOCITY=0.30
WEIGHT_SIMILARITY=0.40
WEIGHT_BASELINE=0.30

# ── Autonomy ──────────────────────────────────────────────────────────────────
DEFAULT_AUTONOMY_TIER=propose

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
