# LogPilot environment variables
# Copy to .env and fill in real values

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://logpilot:logpilot@postgres:5432/logpilot

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-char-random-string

# ── AI Service ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
