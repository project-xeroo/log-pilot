# LogPilot environment variables — copy to .env and fill in real values.
# docker-compose.yml supplies container-network defaults; values here override them.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://logpilot:logpilot@localhost:5432/logpilot

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object Storage (SeaweedFS S3 locally / S3 in the cloud) ──────────────────────────────────
STORAGE_BUCKET=logpilot-uploads
STORAGE_ENDPOINT_URL=http://object-store:8333   # blank for AWS S3
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1

# ── Service URLs (internal Docker network) ───────────────────────────────────
INGESTION_SERVICE_URL=http://log-ingestion-service:8001
AI_SERVICE_URL=http://ai-service:8002
FORECASTING_SERVICE_URL=http://forecasting-service:8003
AUDIT_SERVICE_URL=http://audit-service:8005

# ── AI Provider (PRD §6) ─────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, a proxy, local vLLM…).
# Leave OPENAI_API_KEY empty (or set AI_PROVIDER=stub) to run fully offline
# with deterministic stub answers and pseudo-embeddings.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model assignments (PRD §6.1) — swap without code changes
EMBEDDING_MODEL=text-embedding-3-small   # embeddings, semantic search, clustering
CHAT_MODEL=gpt-4o-mini                   # fast reasoning: chat, search answers
REASONING_MODEL=gpt-4o                   # deep reasoning: RCA, reports, pre-mortems

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECASTING_LOOP_INTERVAL_SECONDS=60
FORECASTING_WARNING_THRESHOLD=60.0
FORECASTING_CRITICAL_THRESHOLD=80.0
WEIGHT_VELOCITY=0.30
WEIGHT_SIMILARITY=0.40
WEIGHT_BASELINE=0.30

# ── Autonomy ──────────────────────────────────────────────────────────────────
DEFAULT_AUTONOMY_TIER=propose

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ── Misc ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
