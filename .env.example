# ============================================================
# LogPilot — Phase 1 local development environment variables
# Copy this file to .env and fill in real values
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://logpilot:logpilot@postgres:5432/logpilot
DATABASE_URL_SYNC=postgresql://logpilot:logpilot@postgres:5432/logpilot
POSTGRES_USER=logpilot
POSTGRES_PASSWORD=logpilot
POSTGRES_DB=logpilot

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT ──────────────────────────────────────────────────────
# CHANGE THIS before deploying — must be long, random, and secret
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ── Object Storage (MinIO local / S3 cloud) ──────────────────
STORAGE_BUCKET=logpilot-uploads
STORAGE_ENDPOINT_URL=http://minio:9000      # blank for AWS S3
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1

# ── Service URLs (internal Docker network) ───────────────────
INGESTION_SERVICE_URL=http://log-ingestion-service:8001
AI_SERVICE_URL=http://ai-service:8002

# ── AI Provider (Phase 2) ────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# ── Misc ─────────────────────────────────────────────────────
DEBUG=false
