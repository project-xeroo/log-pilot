# Local development: leave both unset — Vite proxies /api and /ws to the gateway
# (override the gateway address with GATEWAY_URL, default http://localhost:8000).
#
# Static hosting / CDN: point the console straight at the gateway instead.
# VITE_API_BASE_URL=https://api.logpilot.example.com
# VITE_WS_URL=wss://api.logpilot.example.com
